# Database is project-local by default. Relative URLs are resolved from backend/.
AGENTCONNECT_DATABASE_URL=sqlite:///./data/agentconnect.db

# Optional. The application starts and serves all APIs without a key.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_SECONDS=15

AGENTCONNECT_RELEVANCE_THRESHOLD=0.25
AGENTCONNECT_RELEVANCE_TOP_K=5
