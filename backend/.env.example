# Database is project-local by default. Relative URLs are resolved from backend/.
AGENTCONNECT_DATABASE_URL=sqlite:///./data/agentconnect.db
# PostgreSQL 18: install requirements-postgres.txt. Existing databases use the
# verified scripts/migrate_postgres.py runner with a distinct empty restore DB.
# AGENTCONNECT_DATABASE_URL=postgresql+psycopg://agentconnect:URL_SAFE_PASSWORD@localhost:5432/agentconnect
# AGENTCONNECT_RESTORE_DATABASE_URL=postgresql+psycopg://restore_user:URL_SAFE_PASSWORD@localhost:5432/agentconnect_restore

# Authentication. Production requires explicit HTTPS trusted origins and uses
# Secure, HTTP-only __Host- session cookies; development uses localhost cookies.
AGENTCONNECT_ENV=development
AGENTCONNECT_TRUSTED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
AGENTCONNECT_SESSION_HOURS=24
AGENTCONNECT_LOGIN_ATTEMPTS=10
AGENTCONNECT_COOKIE_SECURE=false
# No email delivery is configured. Explicit local development invitation links only.
AGENTCONNECT_DEV_INVITATIONS=false

# Optional. The application starts and serves all APIs without a key.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_SECONDS=15

# Product runtime defaults to a 30-second provider deadline. The variable above
# is retained for the opt-in legacy demo adapter only.
# Opt in explicitly for local fake-provider demonstrations; never a silent fallback.
AGENTCONNECT_ENABLE_FAKE=false

# Optional JSON platform limits; company/agent limits may further restrict these.
# Cooldown uses the largest applicable value; all other limits use the smallest.
AGENTCONNECT_LIMITS='{"max_agent_messages":3,"max_conversation_messages":12,"max_reply_depth":6,"max_participants":8,"max_concurrent_runs":2,"max_retries":3,"timeout_seconds":30,"cooldown_seconds":30,"daily_runs":100}'

AGENTCONNECT_RELEVANCE_THRESHOLD=0.25
AGENTCONNECT_RELEVANCE_TOP_K=5

# Authenticated workspace mutations per user/company over 15 minutes.
AGENTCONNECT_WRITE_ATTEMPTS=600
# Aggregate UTC daily provider-attempt budget, including retries and legacy work.
AGENTCONNECT_DAILY_COMPANY_BUDGET=1000
