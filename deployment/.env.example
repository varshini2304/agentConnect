# Copy to deployment/.env and replace these values. Use a URL-safe password.
POSTGRES_PASSWORD=replace-with-at-least-32-random-hex-characters
AGENTCONNECT_DATABASE_PASSWORD=replace-with-a-different-random-hex-password
AGENTCONNECT_TRUSTED_ORIGINS=https://agents.example.com
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Platform caps; company/agent settings can further restrict them.
AGENTCONNECT_LIMITS='{"max_agent_messages":3,"max_conversation_messages":12,"max_reply_depth":6,"max_participants":8,"max_concurrent_runs":2,"max_retries":3,"timeout_seconds":30,"cooldown_seconds":30,"daily_runs":100}'
AGENTCONNECT_DAILY_COMPANY_BUDGET=1000
AGENTCONNECT_WRITE_ATTEMPTS=600
AGENTCONNECT_LOGIN_ATTEMPTS=10
AGENTCONNECT_SESSION_HOURS=24
